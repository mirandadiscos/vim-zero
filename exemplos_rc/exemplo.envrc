# Exemplo de arquivo .envrc para uso com o direnv
# Para usar, copie este arquivo para o diretório do seu projeto como .envrc
# e execute `direnv allow`

# --- Carregar ASDF ---
# Carrega as versões de ferramentas definidas no arquivo .tool-versions
# (criado por `asdf local <ferramenta> <versao>`)
use asdf

# --- Variáveis de Ambiente ---
# Define variáveis de ambiente específicas para este projeto
export NODE_ENV="development"
# export DATABASE_URL="postgres://user:password@localhost:5432/meu_banco"

# --- Modificação do PATH ---
# Adiciona o diretório node_modules/.bin ao PATH para executar
# binários de pacotes npm locais (ex: jest, webpack-cli)
path_add node_modules/.bin

# --- Mensagem ao Entrar no Diretório ---
# Mostra uma mensagem informativa sempre que o direnv carregar o ambiente
echo "Ambiente de desenvolvimento para o projeto X carregado. (direnv)"
